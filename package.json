{
  "name": "ts-graphviz-monorepo",
  "private": true,
  "description": "Graphviz libraries for TypeScript",
  "keywords": [
    "graphviz",
    "dot"
  ],
  "homepage": "https://ts-graphviz.github.io/api/",
  "bugs": {
    "url": "https://github.com/ts-graphviz/ts-graphviz/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ts-graphviz/ts-graphviz.git"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/ts-graphviz"
    },
    {
      "type": "opencollective",
      "url": "https://opencollective.com/ts-graphviz"
    }
  ],
  "license": "MIT",
  "author": "kamiazya <yuki@kamiazya.tech>",
  "type": "module",
  "scripts": {
    "codegen": "pnpm -r codegen",
    "build": "pnpm -r --filter './packages/*' build",
    "doc": "typedoc",
    "lint": "biome check --write ./**",
    "test": "vitest",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit --strict --skipLibCheck",
    "typecheck:strict": "node node_modules/@typescript/native/bin/tsc --project tsconfig.packages.json --noEmit --skipLibCheck false",
    "test:e2e": "pnpm --filter @ts-graphviz/e2e test",
    "knip": "knip",
    "fuzz:build": "vite build --config fuzz/vite.config.ts",
    "fuzz": "bash fuzz/run.sh",
    "check:packages": "node scripts/check-packages.ts",
    "api:check": "node scripts/api-report.ts",
    "api:update": "node scripts/api-report.ts --update",
    "check:doc-examples": "node scripts/check-doc-examples.ts",
    "build:website": "pnpm build && pnpm doc && pnpm --filter @ts-graphviz/website build && pnpm --filter @ts-graphviz/website copy-api && pnpm --filter @ts-graphviz/website check-links"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "2.6.2",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@jazzer.js/core": "4.0.0",
    "@types/node": "catalog:",
    "@types/react": "^19.3.0",
    "@typescript/native": "catalog:",
    "@vitest/coverage-v8": "^5.0.5",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.3",
    "knip": "^6.42.1",
    "lefthook": "2.2.1",
    "oxc-parser": "^0.154.0",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "svgo": "^4.1.0",
    "typedoc": "^0.28.20",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.15.0"
}
