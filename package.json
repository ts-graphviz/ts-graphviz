{
  "name": "ts-graphviz-monorepo",
  "private": true,
  "description": "Graphviz libraries for TypeScript",
  "keywords": [
    "graphviz",
    "dot"
  ],
  "homepage": "https://ts-graphviz.github.io/ts-graphviz/",
  "bugs": {
    "url": "https://github.com/ts-graphviz/ts-graphviz/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ts-graphviz/ts-graphviz.git"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/ts-graphviz"
    },
    {
      "type": "opencollective",
      "url": "https://opencollective.com/ts-graphviz"
    }
  ],
  "license": "MIT",
  "author": "kamiazya <yuki@kamiazya.tech>",
  "type": "module",
  "scripts": {
    "codegen": "pnpm -r codegen",
    "build": "pnpm -r build",
    "doc": "typedoc",
    "lint": "biome check --write ./**",
    "test": "vitest",
    "typecheck": "tsc --noEmit --strict --skipLibCheck",
    "typecheck:strict": "tsc --project tsconfig.packages.json --noEmit --skipLibCheck false",
    "test:e2e": "pnpm --filter @ts-graphviz/e2e test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.31.1",
    "@pnpm/workspace.find-packages": "^1000.0.65",
    "@pnpm/workspace.pkgs-graph": "^1000.0.39",
    "@types/node": "catalog:",
    "@types/react": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.1.3",
    "lefthook": "^1.13.6",
    "react": "^19.3.1",
    "svgo": "^3.3.5",
    "typedoc": "^0.28.20",
    "typedoc-plugin-mdn-links": "^5.1.1",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.15.0"
}
