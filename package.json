{
  "name": "ts-graphviz-monorepo",
  "private": true,
  "description": "Graphviz libraries for TypeScript",
  "keywords": [
    "graphviz",
    "dot"
  ],
  "homepage": "https://ts-graphviz.github.io/api/",
  "bugs": {
    "url": "https://github.com/ts-graphviz/ts-graphviz/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ts-graphviz/ts-graphviz.git"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/ts-graphviz"
    },
    {
      "type": "opencollective",
      "url": "https://opencollective.com/ts-graphviz"
    }
  ],
  "license": "MIT",
  "author": "kamiazya <yuki@kamiazya.tech>",
  "type": "module",
  "scripts": {
    "codegen": "pnpm -r codegen",
    "build": "pnpm -r --filter './packages/*' build",
    "doc": "typedoc",
    "lint": "biome check --write ./**",
    "test": "vitest",
    "typecheck": "tsc --noEmit --strict --skipLibCheck",
    "typecheck:strict": "tsc --project tsconfig.packages.json --noEmit --skipLibCheck false",
    "test:e2e": "pnpm --filter @ts-graphviz/e2e test",
    "build:website": "pnpm build && pnpm doc && pnpm --filter @ts-graphviz/website build && pnpm --filter @ts-graphviz/website copy-api && pnpm --filter @ts-graphviz/website check-links"
  },
  "devDependencies": {
    "@biomejs/biome": "2.0.0",
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.29.4",
    "@pnpm/workspace.find-packages": "^1000.0.24",
    "@pnpm/workspace.pkgs-graph": "^1000.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "jsdom": "^26.1.0",
    "lefthook": "^1.13.6",
    "react": "^19.0.0",
    "svgo": "^3.3.2",
    "typedoc": "^0.28.4",
    "typedoc-plugin-mdn-links": "^5.0.10",
    "typescript": "~5.8.3",
    "vite": "^7.2.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.12.1",
