// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Root graphs built with digraph() and graph() > escape special characters in names and labels 1`] = `
"graph "G\\n\\"" {
  "a\\na" [
    label = "1\\n2\\n\\"\\n3";
  ];
  "b\\"b";
  "c\\nc\\"";
  "a\\na" -- "b\\"b" -- "c\\nc\\"" [
    color = "red";
  ];
  subgraph "graph.name" {
    "node.name" [
      label = "node";
    ];
    "another.name" [
      label = "words with space and \\"quote\\"";
    ];
    "node.name" -- "another.name";
  }
}"
`;

exports[`Root graphs built with digraph() and graph() > print the comments of the graph, nodes, edges and subgraphs 1`] = `
"// This is directed graph.
digraph "G" {
  // This is node a.
  "aa";
  // This is node b.
  "bb";
  // This is node c.
  "cc";
  // This is edge.
  // It connects a, b and c.
  "aa" -> "bb" -> "cc" [
    color = "red";
  ];
  // It is subgraph A.
  // It is not cluster
  subgraph "A" {
    // This is node Aaa in subgraph A.
    "Aaa" [
      color = "pink";
    ];
  }
}"
`;
