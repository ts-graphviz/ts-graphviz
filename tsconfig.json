{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // Declarations are only emitted for package sources, which
    // tsconfig.packages.json checks with isolatedDeclarations.
    "isolatedDeclarations": false,
    "paths": {
      "ts-graphviz": [
        "./packages/ts-graphviz/src/ts-graphviz.js"
      ],
      "ts-graphviz/adapter": [
        "./packages/ts-graphviz/src/adapter.js"
      ],
      "ts-graphviz/ast": [
        "./packages/ts-graphviz/src/ast.js"
      ],
      "@ts-graphviz/core": [
        "./packages/core/src/core.js"
      ],
      "@ts-graphviz/common": [
        "./packages/common/src/common.js"
      ],
      "@ts-graphviz/ast": [
        "./packages/ast/src/ast.js"
      ],
      "@ts-graphviz/adapter": [
        "./packages/adapter/src/node.js"
      ],
      "@ts-graphviz/react": [
        "./packages/react/src/react.js"
      ]
    }
  },
  "exclude": [
    // require()s the ESM-only packages, which needs `module: nodenext`;
    // `pnpm check:consumer-types` type-checks it so.
    "test/consumer/cjs.cts",
    "website",
    "**/node_modules",
    "**/lib",
    "**/doc"
  ]
}
