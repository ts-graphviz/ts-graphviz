{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "media/*.tsx",
        "scripts/*.ts",
        "vitest.mutation.config.ts",
        "test/consumer/*.{ts,tsx,cts}",
        "fuzz/targets/*.fuzz.ts"
      ],
      "ignoreDependencies": [
        "publint",
        "@arethetypeswrong/cli",
        "typescript-5.0",
        "types-node-ts5.0"
      ],
      "ignoreBinaries": [
        "dot"
      ],
      "ignore": [
        "tools/biome-plugins/fixtures/**"
      ]
    },
    "packages/ts-graphviz": {
      "entry": [
        "example/runkit.cjs"
      ]
    },
    "packages/react": {
      "entry": [
        "example/example.tsx"
      ]
    },
    "e2e": {
      "ignoreDependencies": [
        "verdaccio-auth-memory"
      ]
    },
    "website": {
      "entry": [
        "src/theme/**/*.{ts,tsx}",
        "test/mocks/*.{ts,tsx}"
      ],
      "ignoreDependencies": [
        "@docusaurus/theme-classic",
        "@docusaurus/plugin-content-docs"
      ],
      "ignoreExportsUsedInFile": true
    }
  }
}
