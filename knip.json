{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "media/*.tsx",
        "scripts/*.ts"
      ],
      "ignoreDependencies": [
        "publint",
        "@arethetypeswrong/cli"
      ],
      "ignoreBinaries": [
        "dot"
      ]
    },
    "packages/ts-graphviz": {
      "entry": [
        "example/runkit.cjs"
      ]
    },
    "packages/react": {
      "entry": [
        "example/example.tsx"
      ]
    },
    "e2e": {
      "ignoreDependencies": [
        "verdaccio-auth-memory"
      ]
    },
    "website": {
      "entry": [
        "src/theme/**/*.{ts,tsx}"
      ],
      "ignoreDependencies": [
        "@docusaurus/theme-classic",
        "@docusaurus/plugin-content-docs"
      ],
      "ignoreExportsUsedInFile": true
    }
  }
}
