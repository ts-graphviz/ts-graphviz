# DOT tokens for libFuzzer mutations.
kw_graph="graph"
kw_digraph="digraph"
kw_subgraph="subgraph"
kw_strict="strict"
kw_node="node"
kw_edge="edge"
op_dir="->"
op_undir="--"
open_brace="{"
close_brace="}"
open_bracket="["
close_bracket="]"
semicolon=";"
comma=","
equals="="
colon=":"
quote="\""
escaped_quote="\\\""
backslash="\\\\"
line_cont="\\\x0a"
html_open="<"
html_close=">"
html_table="<TABLE><TR><TD>"
html_end="</TD></TR></TABLE>"
html_img="<IMG SRC=\"x\"/>"
block_comment_open="/*"
block_comment_close="*/"
line_comment="//"
macro_comment="#"
compass_ne=":ne"
compass_c=":c"
attr_label="label"
attr_image="image"
attr_shapefile="shapefile"
attr_url="URL"
number="-1.5"
number_dot=".5"
newline="\x0a"
crlf="\x0d\x0a"
nul="\x00"
