graph ER {
	layout=neato
	node [shape=box]; course; institute; student;
	node [shape=ellipse]; {node [label="name"] name0; name1; name2;}
		code; grade; number;
	node [shape=diamond,styleEdge=filled,color=lightgrey]; "C-I"; "S-C"; "S-I"
