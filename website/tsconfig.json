{
  // Used for type checking (`pnpm typecheck`) and editors; Docusaurus
  // compiles with Babel and does not read it.
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    "baseUrl": ".",
    // The Playground imports ts-graphviz's sources from the workspace, which
    // are written for strict mode.
    "strict": true,
    "types": ["node"]
  },
  "exclude": [
    "scripts",
    "build",
    ".docusaurus"
  ]
}
