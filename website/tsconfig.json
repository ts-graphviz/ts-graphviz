{
  // Used for type checking (`pnpm typecheck`) and editors; Docusaurus
  // compiles with Babel and does not read it.
  //
  // The options of @docusaurus/tsconfig, without its `baseUrl`, which
  // TypeScript 7 removed (and which tools reading this file, such as
  // Playwright, do not let a `null` override). `paths` is relative to this
  // file.
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "bundler",
    "module": "esnext",
    "noEmit": true,
    "paths": {
      "@site/*": ["./*"]
    },
    "skipLibCheck": true,
    // The Playground imports ts-graphviz's sources from the workspace, which
    // are written for strict mode.
    "strict": true,
    "types": ["node"]
  },
  "exclude": [
    "scripts",
    "build",
    ".docusaurus",
    "node_modules"
  ]
}
