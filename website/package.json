{
  "name": "@ts-graphviz/website",
  "version": "0.0.0",
  "private": true,
  "description": "The ts-graphviz documentation site (https://ts-graphviz.github.io)",
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "pnpm extract-dts && docusaurus start",
    "start:ja": "pnpm extract-dts && docusaurus start --locale ja",
    "start:zh": "pnpm extract-dts && docusaurus start --locale zh-CN",
    "extract-dts": "node scripts/extract-dts.mts",
    "build": "pnpm extract-dts && docusaurus build",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear",
    "swizzle": "docusaurus swizzle",
    "write-translations": "docusaurus write-translations",
    "write-translations:ja": "docusaurus write-translations --locale ja",
    "write-translations:zh": "docusaurus write-translations --locale zh-CN",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc",
    "copy-api": "node scripts/copy-api-reference.mts",
    "check-links": "node scripts/check-links.mts"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/remark-plugin-npm2yarn": "3.10.2",
    "@docusaurus/theme-classic": "3.10.2",
    "@docusaurus/theme-common": "3.10.2",
    "@hpcc-js/wasm-graphviz": "^1.30.0",
    "@mdx-js/react": "^3.1.0",
    "@monaco-editor/react": "^4.7.0",
    "@tsparticles/engine": "^3.9.1",
    "@tsparticles/react": "^3.0.0",
    "@tsparticles/slim": "^3.9.1",
    "@webcontainer/api": "^1.6.4",
    "clsx": "^2.1.1",
    "monaco-editor": "^0.52.2",
    "prism-react-renderer": "^2.4.1",
    "prismjs": "^1.30.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-loading-indicators": "^1.0.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@types/mdast": "^4.0.4",
    "@types/node": "^20.17.46",
    "@types/react": "^19.1.8",
    "@types/unist": "^3.0.3",
    "linkinator": "^8.1.0",
    "mdast-util-mdx-jsx": "^3.2.0",
    "typescript": "~5.8.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "utility-types": "^3.11.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  }
}
