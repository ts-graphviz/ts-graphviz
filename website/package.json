{
  "name": "@ts-graphviz/website",
  "version": "0.0.0",
  "private": true,
  "description": "The ts-graphviz documentation site (https://ts-graphviz.github.io)",
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "pnpm extract-dts && pnpm generate-hero && docusaurus start",
    "start:ja": "pnpm extract-dts && pnpm generate-hero && docusaurus start --locale ja",
    "start:zh": "pnpm extract-dts && pnpm generate-hero && docusaurus start --locale zh-CN",
    "extract-dts": "node scripts/extract-dts.mts",
    "build": "pnpm extract-dts && pnpm generate-hero && docusaurus build",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear",
    "swizzle": "docusaurus swizzle",
    "write-translations": "docusaurus write-translations",
    "write-translations:ja": "docusaurus write-translations --locale ja",
    "write-translations:zh": "docusaurus write-translations --locale zh-CN",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "pnpm generate-hero && tsc",
    "copy-api": "node scripts/copy-api-reference.mts",
    "check-links": "node scripts/check-links.mts",
    "generate-hero": "tsx scripts/generate-hero-graph.mts",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/remark-plugin-npm2yarn": "3.10.2",
    "@docusaurus/theme-classic": "3.10.2",
    "@docusaurus/theme-common": "3.10.2",
    "@hpcc-js/wasm-graphviz": "^1.30.0",
    "@mdx-js/react": "^3.1.0",
    "@monaco-editor/react": "^4.7.0",
    "clsx": "^2.1.1",
    "monaco-editor": "^0.52.2",
    "prism-react-renderer": "^2.4.1",
    "prismjs": "^1.30.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sucrase": "^3.35.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.5",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.1.8",
    "@types/unist": "^3.0.3",
    "fast-check": "^4.10.2",
    "jsdom": "^26.1.0",
    "linkinator": "^8.1.0",
    "mdast-util-mdx-jsx": "^3.2.0",
    "ts-graphviz": "workspace:^",
    "tsx": "4.23.15",
    "typescript": "^7.0.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "utility-types": "^3.11.0",
    "vitest": "^3.2.4"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  }
}
