/**
 * Draw the graph behind the landing page's hero with ts-graphviz itself:
 * a directed graph flowing left to right, laid out by Graphviz `dot`
 * (rendered with the WebAssembly build, so no Graphviz binary is needed).
 *
 * The output, `src/components/HeroSection/hero-graph.svg`, is generated by
 * `start` and `build` and not committed. Lines and nodes are drawn in
 * `currentColor`, so the stylesheet decides their colour and opacity. A fixed
 * seed keeps the picture the same from one build to the next; change SEED to
 * get a different one.
 */
import { writeFileSync } from 'node:fs';
import { dirname, resolve } from 'node:path';
import { fileURLToPath } from 'node:url';
import { Graphviz } from '@hpcc-js/wasm-graphviz';
import { digraph, toDot } from 'ts-graphviz';

const SEED = 42;
/** Ranks from left to right, and the range of nodes in each. */
const RANKS = 18;
const MIN_WIDTH = 3;
const MAX_WIDTH = 7;

const output = resolve(
  dirname(fileURLToPath(import.meta.url)),
  '../src/components/HeroSection/hero-graph.svg',
);

/** mulberry32: a small seeded PRNG. */
function random(seed: number): () => number {
  let state = seed;
  return () => {
    state = (state + 0x6d2b79f5) | 0;
    let t = Math.imul(state ^ (state >>> 15), 1 | state);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const next = random(SEED);
const pick = <T,>(items: T[]): T => items[Math.floor(next() * items.length)];

const graph = digraph(
  'hero',
  {
    rankdir: 'LR',
    // close to the hero's own proportions, so little is cropped
    size: '16,10!',
    ratio: 'fill',
    nodesep: 0.18,
    ranksep: 0.55,
    bgcolor: 'transparent',
    pad: 0,
    margin: 0,
  },
  (g) => {
    g.node({
      shape: 'box',
      style: 'rounded',
      width: 0.42,
      height: 0.2,
      fixedsize: true,
      label: '',
      penwidth: 1.2,
    });
    g.edge({ arrowsize: 0.5, penwidth: 1 });
    let previous = ['r0_0'];
    g.node('r0_0');
    for (let rank = 1; rank < RANKS; rank++) {
      const width = MIN_WIDTH + Math.floor(next() * (MAX_WIDTH - MIN_WIDTH + 1));
      const current: string[] = [];
      for (let i = 0; i < width; i++) {
        const id = `r${rank}_${i}`;
        current.push(id);
        g.node(id);
        g.edge([pick(previous), id]);
        if (next() < 0.35) g.edge([pick(previous), id]);
      }
      previous = current;
    }
  },
);

const graphviz = await Graphviz.load();
const rendered = graphviz.dot(toDot(graph));
// keep only the <svg> element: drops the XML declaration, doctype and the
// generator comment before it (comments inside are removed by SVGO later)
const svg = rendered
  .slice(rendered.indexOf('<svg'))
  .replace(/<title>[^<]*<\/title>\s*/g, '')
  // let CSS size the picture: keep the viewBox, crop to fill the hero
  .replace(
    /<svg\s+width="[^"]*"\s+height="[^"]*"/,
    '<svg preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false"',
  )
  // drop the background rectangle Graphviz draws for the graph
  .replace(/<polygon fill="(?:white|transparent)"[^>]*\/>\s*/, '')
  .replaceAll('#000000', 'currentColor')
  .replaceAll('"black"', '"currentColor"');
Graphviz.unload();

writeFileSync(output, `${svg.trim()}\n`);
console.log(`wrote ${output}`);
